# FactoryOps local development — copied to .env by make one-shot (never overwrite secrets)
COMPOSE_PROJECT_NAME=factoryops
PROFILE=local
DOMAIN=localhost
PRODUCT_NAME=FactoryOps
PRODUCT_ACCENT=#0B6E4F

# Public URLs (Traefik)
APP_URL=http://localhost:18080
API_URL=http://localhost:18080/api
KEYCLOAK_URL=http://localhost:18080/auth
GRAFANA_URL=http://localhost:13001
PROMETHEUS_URL=http://localhost:19090
TEMPORAL_UI_URL=http://localhost:18088
MINIO_CONSOLE_URL=http://localhost:19001

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=factoryops
POSTGRES_USER=factoryops
POSTGRES_PASSWORD=factoryops_dev_change_me
DATABASE_URL=postgresql+psycopg://factoryops:factoryops_dev_change_me@postgres:5432/factoryops

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=factoryops
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Redpanda / Kafka
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_CLIENT_ID=factoryops

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=factoryops
MINIO_SECRET_KEY=factoryops_minio_change_me
MINIO_BUCKET_RAW=fo-raw
MINIO_BUCKET_EVIDENCE=fo-evidence
MINIO_BUCKET_MODELS=fo-models
MINIO_BUCKET_DOCS=fo-docs

# Temporal
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default

# MQTT
MQTT_HOST=mosquitto
MQTT_PORT=1883

# Keycloak / OIDC
OIDC_ISSUER=http://localhost:18080/auth/realms/factoryops
OIDC_AUDIENCE=factoryops-api
OIDC_CLIENT_ID=factoryops-web
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_change_me
# Local substitute when Keycloak is warming: demo bearer tokens
AUTH_MODE=oidc_with_demo_fallback
DEMO_PASSWORD=demo

# Agents
AGENT_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AGENT_MAX_TOKENS=8000
AGENT_TIMEOUT_S=60

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=INFO

# OT/IT connector local substitutes (seeded adapters hit these via HTTP)
# Compose in-cluster default: http://api:8000 — host-run API: http://127.0.0.1:18000
CONNECTOR_SIM_BASE_URL=http://api:8000

# Secrets (generated if empty)
SESSION_SECRET=
NEXTAUTH_SECRET=
